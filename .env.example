# copy to .env and fill in as needed. .env is gitignored.

# Airflow
AIRFLOW_UID=50000
# shared secret Airflow's components use to sign/verify internal task
# execution requests. The docker-compose default is fine for local dev;
# generate your own with `python3 -c "import secrets; print(secrets.token_hex(32))"`
# for anything shared beyond your machine.
AIRFLOW_SECRET_KEY=

# dbt / BigQuery (prod target, only needed for Phase 4)
BQ_PROJECT=
BQ_DATASET=gharchive
BQ_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=
BQ_ALLOW_DML=false

# ingestion
GHARCHIVE_BASE_URL=https://data.gharchive.org
GHARCHIVE_MAX_CONCURRENT_DOWNLOADS=8
GHARCHIVE_LOOKBACK_DAYS=90
