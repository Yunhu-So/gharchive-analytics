# copy to .env and fill in as needed. .env is gitignored.

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# dbt / DuckDB (dev target, no credentials required)
DBT_PROFILES_DIR=/usr/local/airflow/dbt
DUCKDB_PATH=/usr/local/airflow/gharchive.duckdb

# dbt / BigQuery (prod target, only needed for Phase 4)
BQ_PROJECT=
BQ_DATASET=gharchive
BQ_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=
BQ_ALLOW_DML=false

# ingestion
GHARCHIVE_BASE_URL=https://data.gharchive.org
GHARCHIVE_MAX_CONCURRENT_DOWNLOADS=8
GHARCHIVE_LOOKBACK_DAYS=90
